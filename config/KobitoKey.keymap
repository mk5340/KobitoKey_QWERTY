#include <input/processors.dtsi>
#include <layout_shift_kp_override.dtsi> //JIS変換の処理を追加（2026/09/21）
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    combos {
        compatible = "zmk,combos";

        Mouse01 {
            bindings = <&mkp MB1>;
            key-positions = <17 18>;
            timeout-ms = <50>;
        };

        Mouse02 {
            bindings = <&mkp MB2>;
            key-positions = <7 8>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp Q         &kp W         &kp E  &kp R        &kp T      &kp Y        &kp U                     &kp I             &kp O      &kp P
&mt LSHIFT A  &mt S LCTRL   &kp D  &kp F        &kp G      &kp H        &lt 3 J                   &kp K             &kp L      &mt RCTRL ENTER
&lt 5 Z       &kp X         &kp C  &kp V        &kp B      &kp N        &kp M                     &kp COMMA         &kp DOT    &kp MINUS
&kp ESC       &mt LCTRL F7  &mo 1  &lt 3 SPACE  &lt 2 TAB  &lt 3 GRAVE  &mt LEFT_SHIFT BACKSPACE  &mt LEFT_ALT F10  &kp RSHFT  &kp RIGHT_WIN
            >;
        };

        layer1 {
            label = "NUMBER";
            bindings = <
&kp PERCENT                &kp DOLLAR       &kp AMPERSAND  &kp UNDERSCORE   &kp SLASH     &kp NON_US_BACKSLASH  &kp LEFT_BRACE        &kp RIGHT_BRACE        &kp LESS_THAN  &kp GREATER_THAN
&kp PIPE                   &kp HASH         &kp ASTERISK   &kp PLUS         &kp EQUAL     &kp AT_SIGN           &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp SEMICOLON  &kp COLON
&kp CARET                  &kp TILDE        &none          &kp EXCLAMATION  &kp QUESTION  &kp GRAVE             &kp LEFT_BRACKET      &kp RIGHT_BRACKET      &kp SQT        &kp DOUBLE_QUOTES
&mt LEFT_SHIFT LEFT_SHIFT  &mt RCTRL RCTRL  &none          &kp LSHFT        &none         &none                 &none                 &none                  &none          &kp RIGHT_WIN
            >;
        };

        layer2 {
            label = "FUNCTION";
            bindings = <
&bt BT_SEL 0               &bt BT_SEL 1     &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &kp SLASH     &kp N7                 &kp N8        &kp N9        &kp COMMA
&mt LEFT_SHIFT LEFT_SHIFT  &mt RCTRL RCTRL  &kp ASTERISK  &kp PLUS      &kp EQUAL     &kp COLON     &kp NUMBER_4           &kp N5        &kp NUMBER_6  &kp N0
&none                      &none            &none         &none         &none         &kp TILDE     &kp NUMBER_1           &kp NUMBER_2  &kp NUMBER_3  &kp PERIOD
&none                      &none            &none         &none         &none         &mt LCTRL F7  &mt LEFT_SHIFT DELETE  &none         &none         &kp LS(LG(S))
            >;
        };

        layer3 {
            label = "MOUSE";
            bindings = <
&kp LC(W)                  &kp LG(LEFT_ARROW)  &kp LG(UP_ARROW)       &kp LG(RIGHT_ARROW)  &none  &kp PAGE_UP         &kp HOME               &kp UP_ARROW    &kp END          &kp PAGE_DOWN
&mt LEFT_SHIFT LEFT_SHIFT  &mt RCTRL RCTRL     &mt LEFT_ALT LEFT_ALT  &kp TAB              &none  &kp LA(LEFT_ARROW)  &kp LEFT_ARROW         &kp DOWN_ARROW  &kp RIGHT_ARROW  &kp LA(RIGHT_ARROW)
&kp LC(T)                  &kp LC(X)           &kp LC(C)              &kp LC(V)            &none  &kp LC(PAGE_UP)     &kp F2                 &kp F5          &kp F4           &kp LC(PAGE_DOWN)
&none                      &none               &none                  &none                &none  &kp LG(V)           &mt LEFT_SHIFT DELETE  &none           &none            &kp F2
            >;
        };

        layer_4 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        layer_5 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans     &kp LG(N7)        &kp LG(N8)        &kp LG(N9)        &kp LG(S)
&trans  &trans  &trans  &trans  &trans  &trans     &kp LG(NUMBER_4)  &kp LG(N5)        &kp LG(NUMBER_6)  &kp LC(NUMBER_1)
&trans  &trans  &trans  &trans  &trans  &kp LC(R)  &kp LG(NUMBER_1)  &kp LG(NUMBER_2)  &kp LG(NUMBER_3)  &kp LC(NUMBER_2)
&trans  &trans  &trans  &trans  &trans  &trans     &trans            &trans            &trans            &trans
            >;
        };
    };
};
